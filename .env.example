# Environment for local development and alchemy deploys.
# Copy to `.env` and fill in your values.

# Telegram (required for the bot)
BOT_TOKEN=your_telegram_bot_token_here

# Webhook verification (recommended)
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Shared secret for internal API routes (optional; empty = requests allowed)
API_SECRET=

# Admin alerts (dev stage)
ADMIN_CHAT_ID=1082762347

# Stage (development|production) — defaults per stage when unset
ENVIRONMENT=development

# Cloudflare credentials (only needed for `alchemy deploy` / `alchemy dev`)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
